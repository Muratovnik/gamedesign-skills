{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "game_id": {
      "type": "string",
      "minLength": 1
    },
    "build_id": {
      "type": "string",
      "minLength": 1
    },
    "observer_id": {
      "type": "string",
      "minLength": 1
    },
    "active": {
      "type": "boolean"
    },
    "clock_utc": {
      "type": "string",
      "minLength": 1
    },
    "facts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "unlock_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "right_kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "can_spend_crew_scrap": {
      "type": "boolean"
    },
    "scrap": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "history_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "generator_operational": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "game_id",
    "build_id",
    "observer_id",
    "active",
    "clock_utc",
    "facts",
    "unlock_ids",
    "right_kinds",
    "can_spend_crew_scrap",
    "scrap",
    "history_ids",
    "generator_operational"
  ],
  "additionalProperties": false
}
