{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "game_id": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "const": "scrap_piece"
    },
    "initial_scrap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "initial_generators": {
      "type": "integer",
      "minimum": 0
    },
    "survey_yield_scrap": {
      "type": "integer",
      "minimum": 0
    },
    "repair_cost_scrap": {
      "type": "integer",
      "minimum": 1
    },
    "transfer": {
      "type": "object",
      "properties": {
        "from_id": {
          "type": "string",
          "minLength": 1
        },
        "to_id": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "from_id",
        "to_id",
        "amount"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "game_id",
    "unit",
    "initial_scrap",
    "initial_generators",
    "survey_yield_scrap",
    "repair_cost_scrap",
    "transfer"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
