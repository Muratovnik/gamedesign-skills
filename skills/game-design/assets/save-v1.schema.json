{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "build_id": {
      "const": "lantern-crew-1"
    },
    "game_id": {
      "type": "string",
      "minLength": 1
    },
    "save_id": {
      "type": "string",
      "minLength": 1
    },
    "world_id": {
      "type": "string",
      "minLength": 1
    },
    "clock_utc": {
      "type": "string",
      "minLength": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "public": {
            "type": "boolean"
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "public",
          "value"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "actor_id": {
            "type": "string",
            "minLength": 1
          },
          "tick": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "kind",
          "actor_id",
          "tick"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "delegations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "right_id": {
            "type": "string",
            "minLength": 1
          },
          "from_id": {
            "type": "string",
            "minLength": 1
          },
          "to_id": {
            "type": "string",
            "minLength": 1
          },
          "accepted": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "right_id",
          "from_id",
          "to_id",
          "accepted"
        ],
        "additionalProperties": false
      }
    },
    "election": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "accepted": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "candidate_id",
        "accepted"
      ],
      "additionalProperties": false
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "active",
              "away"
            ]
          },
          "scrap": {
            "type": "integer",
            "minimum": 0
          },
          "unlocks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "known_fact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "rights": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "archive-host"
                  ]
                },
                "expires_at": {
                  "type": "string",
                  "minLength": 1
                },
                "delegable": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "kind",
                "expires_at",
                "delegable"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "status",
          "scrap",
          "unlocks",
          "known_fact_ids",
          "rights"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "crew": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "scrap": {
          "type": "integer",
          "minimum": 0
        },
        "generator": {
          "type": "boolean"
        },
        "treasurer_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "scrap",
        "generator",
        "treasurer_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "build_id",
    "game_id",
    "save_id",
    "world_id",
    "clock_utc",
    "facts",
    "history",
    "delegations",
    "election",
    "members",
    "crew"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
