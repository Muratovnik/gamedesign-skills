{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "game_id": {
      "type": "string",
      "minLength": 1
    },
    "clock": {
      "type": "string",
      "minLength": 1
    },
    "builds": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "outcome_event": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "allowed_events": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "requires_before_resolution": {
            "type": "boolean"
          }
        },
        "required": [
          "outcome_event",
          "meaning",
          "allowed_events",
          "requires_before_resolution"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "game_id",
    "clock",
    "builds"
  ],
  "additionalProperties": false
}
